#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"
subject="$(awk 'NR == 1 { print; exit }' "${message_file}")"

if [[ ! "${subject}" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert):[[:space:]][A-Z] ]]; then
  printf 'Commit subject must use Conventional Commits with an uppercase subject.\n' >&2
  exit 1
fi
